MONGO_URI=mongodb://127.0.0.1:27017/control-deck
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api

# Android APK direct download (optional override)
VITE_ANDROID_APK_URL=/downloads/control-deck.apk
# Windows desktop direct download (optional override)
VITE_WINDOWS_DOWNLOAD_URL=/downloads/control-deck-windows.exe

# Marketplace payments and authenticated package delivery
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PACKAGE_TOKEN_SECRET=replace-with-a-second-long-random-secret
PACKAGE_ROOT=./packages
PUBLIC_API_URL=http://localhost:5000
PACKAGE_SIGNING_PRIVATE_KEY_PATH=./secrets/marketplace-ed25519-private.pem
# Or provide PACKAGE_SIGNING_PRIVATE_KEY_PEM with escaped \n line breaks.
